# Modelo das variáveis de ambiente (referência). Para criar os arquivos .env.development / .env.test / .env.production
# (fora do git) numa instalação nova, use: node scripts/setup/env.mjs '<senha do vps_app>' (docs/instalacao.md).
# O NODE_ENV vem dos scripts do package.json (cross-env) e decide qual arquivo é carregado.

# ── Servidor ──
PORT=3000
HOST=localhost
# Origem pública do app (padrão: http://HOST:PORT)
# APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Banco (Fase 2) ──
DATABASE_URL=mysql://vps_app:<senha>@127.0.0.1:3306/vps_platform_dev
SHADOW_DATABASE_URL=mysql://vps_app:<senha>@127.0.0.1:3306/vps_platform_shadow

# ── Proxmox (gravadas por scripts/pve/bootstrap.sh) ──
PVE_URL=https://192.168.56.10:8006
PVE_NODE=primeiro
# O certificado do nó não tem o IP no SAN: a validação TLS usa o nome do nó (CLAUDE.md, A9)
PVE_TLS_SERVERNAME=primeiro
PVE_CA_FILE=certs/pve-root-ca.pem
PVE_TOKEN_ID=vpsplatform@pve!backend
PVE_TOKEN_SECRET=<uuid do token>

# ── Seeds (Fase 2) ──
# dev/test: senha dos usuários de demonstração (admin@favo.local, ana@, bruno@, carla@, diego@favo.local)
SEED_DEFAULT_PASSWORD=<pelo menos 10 caracteres>
# produção: admin inicial obrigatório (o seed falha sem ele)
# SEED_ADMIN_EMAIL=admin@exemplo.com
# SEED_ADMIN_PASSWORD=<pelo menos 12 caracteres>
# Pool de IPs das VPS (padrão dev: 192.168.56.200–.228; o .229 fica para testes manuais)
# IP_POOL_START=192.168.56.200
# IP_POOL_END=192.168.56.228
# IP_POOL_GATEWAY=192.168.56.10
# DB_POOL_LIMIT=5

# ── Sessão e CSRF (Fase 3) ──
CSRF_SECRET=<pelo menos 32 caracteres aleatórios>
# CSRF_TTL_HOURS=12
# SESSION_IDLE_TTL_HOURS=24
# SESSION_ABSOLUTE_TTL_DAYS=7
# true só com HTTPS (cookies Secure + prefixo __Host-)
# COOKIE_SECURE=false
# PVE_POOL=vps-platform
# PVE_STORAGE=local-lvm
# PVE_BRIDGE=vmbr1
# PVE_VMID_START=2000
# VPS_NAMESERVERS=1.1.1.1 8.8.8.8

# ── Jobs (Fase 4) ──
# Chave AES-256-GCM das senhas no payload dos jobs: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOB_SECRET_KEY=<32 bytes em base64>

# ── Capacidade e cobrança (Fase 5) ──
# CAPACITY_MAX_MEMORY_MB=1536
# CAPACITY_MAX_DISK_GB=12
# MAX_VPS_PER_USER=2
# INVOICE_DUE_HOURS=24
# PAYMENT_LATENCY_MS=1500

# ── Cobrança recorrente (Fase 10) ──
# BILLING_PERIOD_DAYS=30
# BILLING_RENEWAL_NOTICE_DAYS=7      # a fatura de renovação sai 7 dias antes do fim do período
# BILLING_GRACE_DAYS=3               # sem pagamento: suspensa no fim do período e excluída 3 dias depois
# BILLING_TIME_SCALE=1               # relógio acelerado para demonstração: 1440 → 1 dia = 1 minuto

# ── Worker de jobs (Fase 6) ──
# WORKER_ENABLED=true
# WORKER_CONCURRENCY=2
# WORKER_POLL_MS=1000
# WORKER_ID=                       # padrão: hostname da máquina
# RECONCILE_INTERVAL_SECONDS=60
# VPS_WAIT_SSH=true                # espera a porta 22 da VPS abrir antes de marcar RUNNING

# ── Suporte (Fase 8) ──
# SUPPORT_MAX_ACTIVE_PER_AGENT=3
