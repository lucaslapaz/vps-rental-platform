# Modelo das variáveis de ambiente. Copie para .env.development / .env.test / .env.production (fora do git).
# O NODE_ENV vem dos scripts do package.json (cross-env) e decide qual arquivo é carregado.

# ── Servidor ──
PORT=3000
HOST=localhost
# Origem pública do app (padrão: http://HOST:PORT)
# APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Banco (Fase 2) ──
DATABASE_URL=mysql://vps_app:<senha>@127.0.0.1:3306/vps_platform_dev
SHADOW_DATABASE_URL=mysql://vps_app:<senha>@127.0.0.1:3306/vps_platform_shadow

# ── Proxmox (gravadas por scripts/pve/bootstrap.sh) ──
PVE_URL=https://192.168.56.10:8006
PVE_NODE=primeiro
# O certificado do nó não tem o IP no SAN: a validação TLS usa o nome do nó (CLAUDE.md, A9)
PVE_TLS_SERVERNAME=primeiro
PVE_CA_FILE=certs/pve-root-ca.pem
PVE_TOKEN_ID=vpsplatform@pve!backend
PVE_TOKEN_SECRET=<uuid do token>
